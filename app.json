{
  "expo": {
    "name": "两个人的账本",
    "slug": "family-ledger",
    "version": "0.3.1",
    "scheme": "familyledger",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dwigh.familyledger",
      "infoPlist": {
        "NSFaceIDUsageDescription": "解锁仅保存在本机的小金库",
        "NSLocalNetworkUsageDescription": "连接家庭电脑上的账本同步服务",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSCameraUsageDescription": "扫描另一位家庭成员的账本配对二维码"
      },
      "buildNumber": "5"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
